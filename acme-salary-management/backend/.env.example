# Copy to .env and fill in. Never commit .env (it is git-ignored).
APP_ENV=development

# --- Database ---------------------------------------------------------------------------------
# DATABASE_URL        : used by the running API. With Neon use the POOLED string (host contains "-pooler").
# DATABASE_URL_DIRECT : used by Alembic migrations and the seed script. With Neon use the DIRECT string
#                       (same host without "-pooler"). Optional: falls back to DATABASE_URL.
# Neon strings already include sslmode=require, which is all TLS needs. Copy them from the Neon dashboard.
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#   postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# Local docker-compose Postgres example: postgresql://acme:acme@localhost:5432/acme
#
# Machines that cannot load psycopg (e.g. Windows Application Control blocks it): install the
# fallback driver with `pip install pg8000` and write the scheme as postgresql+pg8000://
DATABASE_URL=
DATABASE_URL_DIRECT=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Only read by the seed script (seed/run.py), never by the web app
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=HR Manager
