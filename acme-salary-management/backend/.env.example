# Copy to .env and fill in. Never commit .env.
APP_ENV=development
# Local docker-compose Postgres, or your Neon *pooled* connection string in production
DATABASE_URL=postgresql://acme:acme@localhost:5432/acme
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# Only read by the seed script (seed/run.py), never by the web app
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=HR Manager
